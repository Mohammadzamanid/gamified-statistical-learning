{
  "name": "statlas",
  "productName": "Statlas",
  "version": "0.1.0",
  "description": "Statlas — a gamified, offline-first statistics-learning expedition for desktop",
  "private": true,
  "main": "dist-electron/main/main.js",
  "author": "Mo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run tests/content",
    "test:statistics": "vitest run tests/statistics",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "package:linux": "npm run build && electron-builder --linux dir",
    "package:linux:appimage": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  }
}
